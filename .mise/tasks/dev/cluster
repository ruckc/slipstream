#!/usr/bin/env bash
#MISE description="Create and configure a kind cluster for local development (idempotent)"

set -euo pipefail

REGISTRY_NAME="slipstream-registry"
REGISTRY_PORT="5001"
CLUSTER_NAME="slipstream"
GATEWAY_API_VERSION="v1.2.1"
ENVOY_GATEWAY_VERSION="v1.3.2"

# ── Phase 1: Infrastructure ────────────────────────────────────────────────
# Each step is skipped if already done, but phase 2 always runs regardless.

if docker inspect "${REGISTRY_NAME}" &>/dev/null; then
  echo "→ Registry '${REGISTRY_NAME}' already exists."
else
  echo "→ Creating local registry on port ${REGISTRY_PORT}..."
  docker run -d \
    --restart=always \
    -p "127.0.0.1:${REGISTRY_PORT}:5000" \
    --name "${REGISTRY_NAME}" \
    registry:2
fi

if kind get clusters 2>/dev/null | grep -q "^${CLUSTER_NAME}$"; then
  echo "→ Kind cluster '${CLUSTER_NAME}' already exists."
else
  echo "→ Creating kind cluster '${CLUSTER_NAME}'..."
  kind create cluster --name "${CLUSTER_NAME}" --config kind-config.yaml
fi

if docker network inspect kind 2>/dev/null | grep -q "\"${REGISTRY_NAME}\""; then
  echo "→ Registry already connected to kind network."
else
  echo "→ Connecting registry to kind network..."
  docker network connect kind "${REGISTRY_NAME}"
fi

# Configure registry mirror in each node using the hosts.toml approach.
# kind v0.27+ sets config_path=/etc/containerd/certs.d automatically, so the
# old mirrors TOML patch conflicts. We write hosts.toml directly instead.
echo "→ Configuring registry mirror in cluster nodes..."
for node in $(kind get nodes --name "${CLUSTER_NAME}"); do
  docker exec "${node}" mkdir -p "/etc/containerd/certs.d/localhost:${REGISTRY_PORT}"
  docker exec "${node}" bash -c "cat > \"/etc/containerd/certs.d/localhost:${REGISTRY_PORT}/hosts.toml\" <<'EOF'
[host.\"http://${REGISTRY_NAME}:5000\"]
  capabilities = [\"pull\", \"resolve\"]
EOF"
done

# ── Phase 2: Cluster configuration (always applied, kubectl apply is idempotent) ──
# Add new cluster-level resources here as they are discovered.

echo "→ Configuring local registry discovery..."
kubectl apply -f - <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: local-registry-hosting
  namespace: kube-public
data:
  localRegistryHosting.v1: |
    host: "localhost:${REGISTRY_PORT}"
    help: "https://kind.sigs.k8s.io/docs/user/local-registry/"
EOF

echo "→ Installing Envoy Gateway (${ENVOY_GATEWAY_VERSION}) and Gateway API CRDs..."
helm upgrade --install eg \
  oci://docker.io/envoyproxy/gateway-helm \
  --version "${ENVOY_GATEWAY_VERSION}" \
  --namespace envoy-gateway-system \
  --create-namespace \
  --wait

# status.conditions is nil immediately after CRD creation; kubectl wait returns
# an accessor error if run before the API server has had a chance to populate it.
sleep 5
kubectl wait --for=condition=Established --timeout=60s \
  crd/gatewayclasses.gateway.networking.k8s.io \
  crd/gateways.gateway.networking.k8s.io \
  crd/grpcroutes.gateway.networking.k8s.io \
  crd/httproutes.gateway.networking.k8s.io \
  crd/referencegrants.gateway.networking.k8s.io

echo "→ Creating slipstream-system namespace..."
kubectl apply -f - <<'EOF'
apiVersion: v1
kind: Namespace
metadata:
  name: slipstream-system
EOF

echo "→ Generating self-signed TLS certificate for localhost..."
if ! kubectl get secret slipstream-tls -n slipstream-system &>/dev/null; then
  openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
    -keyout /tmp/slipstream-tls.key \
    -out /tmp/slipstream-tls.crt \
    -subj "/CN=localhost" \
    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
  kubectl create secret tls slipstream-tls \
    --cert=/tmp/slipstream-tls.crt \
    --key=/tmp/slipstream-tls.key \
    --namespace slipstream-system
  rm -f /tmp/slipstream-tls.crt /tmp/slipstream-tls.key
else
  echo "→ TLS secret already exists."
fi

echo "→ Creating GatewayClass, EnvoyProxy config, and Gateway..."
kubectl apply -f - <<'EOF'
---
# EnvoyProxy config: use hostNetwork so kind's extraPortMappings (80/443) work.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: slipstream-proxy-config
  namespace: slipstream-system
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyDeployment:
        patch:
          value:
            spec:
              template:
                spec:
                  hostNetwork: true
                  dnsPolicy: ClusterFirstWithHostNet
      envoyService:
        type: ClusterIP
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: envoy
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
  parametersRef:
    group: gateway.envoyproxy.io
    kind: EnvoyProxy
    name: slipstream-proxy-config
    namespace: slipstream-system
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: slipstream
  namespace: slipstream-system
spec:
  gatewayClassName: envoy
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: All
    - name: https
      protocol: HTTPS
      port: 443
      tls:
        mode: Terminate
        certificateRefs:
          - name: slipstream-tls
            namespace: slipstream-system
      allowedRoutes:
        namespaces:
          from: All
EOF

echo "→ Waiting for Gateway to be programmed..."
kubectl wait gateway/slipstream \
  --namespace slipstream-system \
  --for=condition=Programmed \
  --timeout=120s

# Envoy runs without root so it binds to 10080/10443 instead of 80/443.
# Redirect host ports 80/443 (kind extraPortMappings) to Envoy's actual ports.
# Rules are scoped to the node's own IP so pod→API-server traffic (10.96.0.1:443)
# is NOT intercepted by the redirect.
echo "→ Adding iptables port redirects (80→10080, 443→10443)..."
for node in $(kind get nodes --name "${CLUSTER_NAME}"); do
  node_ip=$(docker exec "${node}" hostname -I | awk '{print $1}')
  docker exec "${node}" iptables -t nat -I PREROUTING -p tcp -d "${node_ip}" --dport 80 -j REDIRECT --to-port 10080 2>/dev/null || true
  docker exec "${node}" iptables -t nat -I PREROUTING -p tcp -d "${node_ip}" --dport 443 -j REDIRECT --to-port 10443 2>/dev/null || true
done

echo ""
echo "Cluster ready. Next:"
echo "  mise run dev:build   # build and push images"
echo "  mise run install     # deploy slipstream"
