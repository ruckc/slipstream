#!/usr/bin/env bash
#MISE description="Install slipstream to the configured Kubernetes cluster"

set -euo pipefail

VALUES_ARGS=("-f" "charts/slipstream/values-dev.yaml")
if [[ -f "charts/slipstream/values-local.yaml" ]]; then
  VALUES_ARGS+=("-f" "charts/slipstream/values-local.yaml")
  echo "   + charts/slipstream/values-local.yaml"
fi

echo "→ Running helm upgrade --install..."
helm upgrade --install slipstream ./charts/slipstream \
  --namespace slipstream-system \
  --create-namespace \
  "${VALUES_ARGS[@]}"

echo "→ Restarting web deployment to pick up any image changes..."
kubectl rollout restart deployment/slipstream-web \
  --namespace slipstream-system

echo "→ Waiting for web deployment to be ready..."
kubectl rollout status deployment/slipstream-web \
  --namespace slipstream-system \
  --timeout=120s

echo "→ Restarting running agent deployments to pick up any image changes..."
kubectl get deployments \
  --all-namespaces \
  --selector='slipstream.io/project' \
  --output=jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' \
  2>/dev/null \
| while read -r ns name; do
  [[ -z "$ns" ]] && continue
  replicas=$(kubectl get deployment "$name" -n "$ns" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "0")
  if [[ "$replicas" -gt 0 ]]; then
    echo "   restarting $ns/$name"
    kubectl rollout restart deployment/"$name" -n "$ns"
  fi
done

echo "→ Applying database migrations..."
kubectl exec --namespace slipstream-system deploy/slipstream-web \
  -- node migrate.mjs

echo "→ Seeding dev accounts..."
kubectl exec --namespace slipstream-system deploy/slipstream-web \
  -- node seed.mjs

echo "Done."
