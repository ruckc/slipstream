#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$PATH"

REPO_ROOT="$(git rev-parse --show-toplevel)"

mise run format
mise run lint

# Auto-stage any files that format rewrote so they travel with the commit.
git diff --quiet apps/agent/Cargo.lock || git add apps/agent/Cargo.lock
git diff --quiet apps/agent/src       || git add apps/agent/src
git diff --quiet apps/metrics-collector/src || git add apps/metrics-collector/src
git diff --quiet apps/project-controller   || git add apps/project-controller
git diff --quiet apps/hubble-collector     || git add apps/hubble-collector
git diff --quiet apps/web || git -C apps/web add -u .

# Rust tests (matches CI check-rust job)
cargo test --manifest-path "$REPO_ROOT/apps/agent/Cargo.toml"
cargo test --manifest-path "$REPO_ROOT/apps/metrics-collector/Cargo.toml"

# Go build (matches CI check-go job)
(cd "$REPO_ROOT/apps/project-controller" && go build -o /dev/null ./cmd/...)
(cd "$REPO_ROOT/apps/hubble-collector" && go build -o /dev/null ./...)

# Helm template render (matches CI check-helm job)
helm template slipstream "$REPO_ROOT/charts/slipstream" -f "$REPO_ROOT/charts/slipstream/ci/values.yaml" > /dev/null
